# Settings for the Ask site on the server. Copy to /etc/dgi-explore/web.env.
# No keys here: API keys go in ~/.config/dgi-explore/keys.env (only dave can read it).

# Who answers the free questions: deepseek or kimi.
DGI_WEB_PROVIDER=deepseek
# Leave the model empty for the provider's usual one (ask/llm.py).
DGI_WEB_MODEL=
DGI_WEB_EFFORT=high

# Beta limits: free questions per person per day, and the site's spending
# cap per month in US dollars. Raise them when the beta has shown the cost.
DGI_WEB_DAILY_LIMIT=20
DGI_WEB_MONTHLY_CAP_USD=20

# Show "This is a test version" on every page.
DGI_WEB_BETA=1

# The site is at the root of its own domain.
DGI_WEB_ROOT=
